# Nest API (browser → this URL directly). Match `PORT` and `API_PREFIX` in recommendation_trip_platform/.env.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Optional: Mapbox (trip route map). https://account.mapbox.com/access-tokens/
# VITE_MAPBOX_ACCESS_TOKEN=

# Optional: ml-model-service for trip discover (POST /itinerary/recommendations; must include /api/v1).
# VITE_RERANK_API_BASE_URL=http://localhost:8001/api/v1
